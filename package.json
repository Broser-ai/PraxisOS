{
  "name": "praxisos-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "swarm": "bash ./swarm.sh",
    "swarm:worker": "bash ./swarm.sh worker",
    "aria:boot": "npx tsx agents/ARIA-orchestrator.ts",
    "luna:harvest": "npx tsx -e \"import { lunaHarvest } from './agents/specialists/LUNA-harvester.ts'; const r=await lunaHarvest(); console.log(JSON.stringify(r,null,2));\"",
    "agent:worker": "node scripts/agent-worker.mjs",
    "agent:tick": "node -e \"fetch(process.env.PRAXIS_BASE_URL||'http://127.0.0.1:3000'+'/api/agents/tick',{method:'POST',headers:{'Content-Type':'application/json','x-agent-worker-secret':process.env.AGENT_WORKER_SECRET||''},body:JSON.stringify({force:true})}).then(r=>r.json()).then(console.log)\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.62.0",
    "@react-three/drei": "^10.7.4",
    "@react-three/fiber": "^9.3.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/three": "^0.179.0",
    "postcss": "8.5.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.4",
    "typescript": "5.7.3"
  }
}
