{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["fra1"],
  "github": {
    "silent": false,
    "autoAlias": true
  },
  "crons": [
    {
      "path": "/api/cron/swarm-tick",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/message-drain",
      "schedule": "*/5 * * * *"
    }
  ]
}
