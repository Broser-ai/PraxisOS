# =========================================================================
# PraxisOS · SANDBOX environment (NOT production / NOT Hetzner clinical)
# Kopiér til .env.sandbox — aldrig commit secrets. Kun mock/fixture providers.
# =========================================================================

# Isolated sandbox marker (docs + scripts check this)
PRAXIS_SANDBOX=1

# --- Database · always mock in sandbox ---------------------------------
PRAXIS_DB=mock

# Placeholder Supabase (unused when PRAXIS_DB=mock)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=sandbox-anon-mock
SUPABASE_SERVICE_ROLE_KEY=sandbox-service-mock

NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3002
NEXT_PUBLIC_APP_REGION=eu-west-1
PRAXIS_SESSION_SECRET=sandbox-session-secret-not-for-production-use-only

# --- Clinical scan · fixtures only (no real patient images) ------------
# Leave Replicate / Roboflow empty so code paths use mocks / fail closed
REPLICATE_API_TOKEN=
REPLICATE_MESH_MODEL=firtoz/trellis
REPLICATE_MESH_VERSION=
ROBOFLOW_API_KEY=
ROBOFLOW_SEGMENT_MODEL=foot-segmentation-ehn9q/1
ROBOFLOW_MODEL=foot-ulcer/1
ROBOFLOW_MODEL_SECONDARY=wounds-detection/1
SCAN_QUALITY_THRESHOLD=70
SCAN_DEMO_IMAGE_URL=

# Shadow / canary stay OFF in sandbox — do not unlock production clinical
PRAXIS_SHADOW_EVAL_ENABLED=false
PRAXIS_ACTIVE_ROUTING_ENABLED=false
FOOT_VISION_CANARY_PERCENT=0
PRAXIS_CAPTURE_GATE_SHADOW=false
PRAXIS_TRIVIEW_SHADOW_ENABLED=false

# --- Agents / SMS · stubs ----------------------------------------------
AGENT_WORKER_SECRET=sandbox-agent-worker-secret
PRAXIS_BASE_URL=http://127.0.0.1:3002
BIRD_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telemetry off
NEXT_PUBLIC_SENTRY_DSN=
LOGFLARE_API_KEY=
NEXT_TELEMETRY_DISABLED=1
