<main style="padding-top:130px;min-height:70vh">
  <div class="container" style="max-width:860px">
    <p class="label" style="margin-bottom:12px">Udekørende</p>
    <h2 class="heading" style="font-size:clamp(32px,4vw,50px);margin-bottom:16px">Vi kommer til <em>dig</em></h2>
    <p style="font-size:16px;line-height:1.75;color:var(--muted);max-width:540px;margin-bottom:48px;font-weight:300">
      Få professionel fodbehandling i dit eget hjem, på dit plejehjem eller din arbejdsplads. Vi medbringer alt udstyr og sikrer en tryg, hygiejnisk behandling.
    </p>

    <div class="mobile-info-grid">
      <div class="mobile-info-card"><div class="mobile-info-icon">🚗</div><div class="mobile-info-title">Vi kører til dig</div><div class="mobile-info-desc">Aarhus &amp; omegn — op til 25 km fra centrum</div></div>
      <div class="mobile-info-card"><div class="mobile-info-icon">🕐</div><div class="mobile-info-title">Fleksible tider</div><div class="mobile-info-desc">Også aften &amp; weekend efter aftale</div></div>
      <div class="mobile-info-card"><div class="mobile-info-icon">🏠</div><div class="mobile-info-title">Alle steder</div><div class="mobile-info-desc">Privat hjem, plejehjem, arbejdsplads eller event</div></div>
    </div>

    <div class="mobile-price-bar">
      <div>
        <h3 style="font-family:var(--display);font-size:20px">Udekørende tillæg</h3>
        <div style="font-size:13px;color:var(--gray);margin-top:4px">Tillægget dækker transport, opsætning &amp; ekstra hygiejne</div>
      </div>
      <div style="font-family:var(--display);font-size:28px">+150 kr</div>
    </div>

    <p style="font-size:12px;letter-spacing:2px;text-transform:uppercase;font-weight:600;margin-bottom:20px">Tilgængelige behandlinger</p>

    <button type="button" class="treatment-row" data-praxis-book="fod-std" style="width:100%;text-align:left;border:0;background:transparent;cursor:pointer">
      <div style="flex:1">
        <span class="treatment-name">Fodbehandling</span>
        <div class="treatment-desc" style="margin-top:4px">Velplejede fødder – fodbad, hård hud, negle og cremepleje</div>
      </div>
      <div style="text-align:right;margin-left:24px">
        <div class="treatment-price">450 kr</div>
        <div class="treatment-time">inkl. tillæg</div>
      </div>
    </button>
    <button type="button" class="treatment-row" data-praxis-book="fod-ext" style="width:100%;text-align:left;border:0;background:transparent;cursor:pointer">
      <div style="flex:1">
        <span class="treatment-name">Udvidet fodbehandling</span>
        <div class="treatment-desc" style="margin-top:4px">Ekstra tid til hård hud, nedgroede negle og ligtorne</div>
      </div>
      <div style="text-align:right;margin-left:24px">
        <div class="treatment-price">550 kr</div>
        <div class="treatment-time">inkl. tillæg</div>
      </div>
    </button>
    <button type="button" class="treatment-row" data-praxis-book="fod-lux" style="width:100%;text-align:left;border:0;background:transparent;cursor:pointer">
      <div style="flex:1">
        <span class="treatment-name">Luksus fodbehandling</span>
        <div class="treatment-desc" style="margin-top:4px">Peeling, dyb massage og ekstra velvære</div>
      </div>
      <div style="text-align:right;margin-left:24px">
        <div class="treatment-price">745 kr</div>
        <div class="treatment-time">75 min · inkl. tillæg</div>
      </div>
    </button>
    <button type="button" class="treatment-row" data-praxis-book="lak-taeer" style="width:100%;text-align:left;border:0;background:transparent;cursor:pointer">
      <div style="flex:1">
        <span class="treatment-name">Lak på tæer</span>
        <div class="treatment-desc" style="margin-top:4px">Klargøring og lakering af tånegle</div>
      </div>
      <div style="text-align:right;margin-left:24px">
        <div class="treatment-price">260 kr</div>
        <div class="treatment-time">inkl. tillæg</div>
      </div>
    </button>

    <div style="margin-top:40px;text-align:center">
      <button type="button" class="btn btn-primary" data-praxis-book>Book Udekørende Tid</button>
    </div>
  </div>
</main>

<!-- Newsletter -->
<section class="newsletter">
  <div class="newsletter-inner">
    <p class="label" style="margin-bottom:16px">Nyhedsbrev</p>
    <h3>Tips, tilbud & <em>inspiration</em></h3>
    <div class="newsletter-form">
      [mc4wp_form id="newsletter"]    </div>
  </div>
</section>
