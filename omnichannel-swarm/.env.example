# Root Traefik gateway · copy to .env
ACME_EMAIL=admin@praxios.dk

# Traefik dashboard basic auth — generate: htpasswd -nb admin 'strong-password'
# Escape every $ as $$ for compose.
TRAEFIK_BASIC_AUTH=admin:$$apr1$$H6uskkkW$$IgXLP6ewTrSuBkTrqE8wj/

# Brand host matrix (DNS A/AAAA → this node)
TRAEFIK_DASHBOARD_HOST=traefik.praxios.dk

PRAXIOS_CRM_HOST=crm.praxios.dk
CIRKEL_CRM_HOST=crm.cirkel.dk
DPN_CRM_HOST=crm.dpnnails.dk

PRAXIOS_VOICE_HOST=voice.praxios.dk
CIRKEL_VOICE_HOST=voice.cirkel.dk
DPN_VOICE_HOST=voice.dpnnails.dk

PRAXIOS_ENGAGE_HOST=engage.praxios.dk
CIRKEL_ENGAGE_HOST=engage.cirkel.dk
DPN_ENGAGE_HOST=engage.dpnnails.dk
