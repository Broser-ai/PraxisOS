# Erxes (XOS) · copy to erxes/.env — never commit real secrets

# Public host routed by Traefik (Praxios first; add Cirkel/DPN host rules later)
ERXES_HOST=crm.praxios.dk

# Core secrets — CHANGE BEFORE PROD
MONGO_INITDB_ROOT_USERNAME=erxes
MONGO_INITDB_ROOT_PASSWORD=change-me-mongo-root
MONGO_DB=erxes

POSTGRES_USER=erxes
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=erxes

REDIS_PASSWORD=change-me-redis

# Erxes gateway / API
JWT_TOKEN_SECRET=change-me-long-random-jwt
DOMAIN=https://crm.praxios.dk

# Optional secondary brand hosts (comma-separated Traefik Host rules)
# EXTRA_CRM_HOSTS=crm.cirkel.dk,crm.dpnnails.dk
