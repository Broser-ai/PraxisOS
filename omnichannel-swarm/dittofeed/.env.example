# Dittofeed · copy to .env — rotate every secret before production

# Traefik hosts: engage.praxios.dk | engage.cirkel.dk | engage.dpnnails.dk
DASHBOARD_API_BASE=https://engage.praxios.dk
WORKSPACE_NAME=Praxios
AUTH_MODE=single-tenant

# Dashboard login (single-tenant)
PASSWORD=change-me-dashboard-password
# openssl rand -base64 32
SECRET_KEY=CHANGE_ME_BASE64_SECRET_KEY_32B_MIN

DATABASE_USER=dittofeed
DATABASE_PASSWORD=change-me-dittofeed-db
DATABASE_HOST=dittofeed-postgres
DATABASE_PORT=5432

CLICKHOUSE_USER=dittofeed
CLICKHOUSE_PASSWORD=change-me-clickhouse

# Set false after first successful bootstrap
BOOTSTRAP=true

IMAGE_TAG=v0.23.0
LITE_MEM_LIMIT=824
