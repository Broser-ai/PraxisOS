# =========================================================================
# PraxisOS · environment-eksempel
# kopiér til .env.local og udfyld før dev-start.
# =========================================================================

# --- Database -----------------------------------------------------------
# "mock"            — alt fra in-memory mock i lib/*.ts (default)
# "supabase-local"  — lokal supabase via `supabase start`
# "supabase-eu"     — produktion · eu-west-1 (Ireland)
PRAXIS_DB=mock

# Server-side (anbefalet). NEXT_PUBLIC_* aliases understøttes også.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # holdes server-side · bruges af admin-routes + /api/signup

# Client-side aliases (sæt i Vercel Production når klar)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3002
NEXT_PUBLIC_APP_REGION=eu-west-1

# Signed staff sessions (HMAC). Required for working-core auth.
PRAXIS_SESSION_SECRET=change-me-to-a-long-random-string

# --- Captcha (F42 / F63 · Turnstile / hCaptcha) --------------------------
# Optional. When CAPTCHA_PROVIDER secrets are set, login/signup verify tokens.
# Without secrets: non-prod accepts any non-empty token (CAPTCHA_DEV_BYPASS=1 default).
# Production fail-closed when captcha is required (CAPTCHA_FAIL_CLOSED default on).
#
# F63 · Site-key UI: login/signup widgets render ONLY when a site key is present
# via NEXT_PUBLIC_* (or server TURNSTILE_SITE_KEY / HCAPTCHA_SITE_KEY). Placeholders
# below are empty — leave empty to skip UI; set real keys in .env.local / production
# (never commit real keys). Site keys are public-by-design; secrets stay server-only.
# CAPTCHA_PROVIDER=turnstile
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# CAPTCHA_PROVIDER=hcaptcha
# HCAPTCHA_SECRET_KEY=
# HCAPTCHA_SITE_KEY=
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
# CAPTCHA_FAIL_CLOSED=1
# CAPTCHA_DEV_BYPASS=1

# --- Bird.com SMS (afløser NemSMS til daglig SMS) -----------------------
BIRD_API_KEY=
BIRD_API_BASE=https://eu1.platform.bird.com
BIRD_SMS_FROM=BYPILAR
BIRD_SMS_CATEGORY=transactional
BIRD_AUTH_MODE=accesskey
BIRD_WORKSPACE_ID=
BIRD_SMS_CHANNEL_ID=

# --- Agent worker / automation -----------------------------------------
AGENT_WORKER_SECRET=
PRAXIS_BASE_URL=http://127.0.0.1:3002
PRAXIS_DEFAULT_TENANT=bypilar
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Public booking / embed / MCP (F6 / F59 / F60) -----------------------
# Comma-separated origins or hosts for booking CORS allowlist (plus tenant.domains).
# PRAXIS_BOOKING_CORS_ORIGINS=https://bypilar.dk,https://www.bypilar.dk
# PRAXIS_BOOKING_ALLOWED_ORIGINS=
# PRAXIS_BOOKING_RATE_LIMIT=30
# PRAXIS_LOOKUP_RATE_LIMIT=20
# MCP CORS allowlist — production omits ACAO unless listed (wildcard only in non-prod).
# PRAXIS_MCP_ORIGINS=https://claude.ai,https://localhost:3002
# Embed script rate-limit (requests / 15 min / IP / tenant); default 120.
# PRAXIS_EMBED_RATE_LIMIT=120

# --- S-H swarm · Meta harness · Prime RL · Worktree --------------------
# See docs/ops/agent-stack-setup.md · docs/vision/prime-agent-rl.md
# LoRA / model training is FORBIDDEN (PRIME_INVARIANTS.NO_MODEL_TRAINING).
PRAXIS_SWARM_ENABLED=true
# SWARM_APPROVE_TOKEN=          # required for humanApproveTask in prod
# PRIME_APPROVE_TOKEN=          # optional; falls back to SWARM_APPROVE_TOKEN
# SWARM_ALLOW_MAIN_MERGE=0      # must be 1 (+ token) for main-target merge intent
# SWARM_INTERVAL_MS=21600000    # autonom daemon interval (local awaken)
# SWARM_PERSIST=1               # file/Supabase persistence (off on Vercel unless 1)
# Local awaken: npm run swarm:awaken
# Human gate (no merge): npm run harness:human-gate

# --- Clinical scan · Del Pilar Nexus (ARIA + S-Agent) -------------------
REPLICATE_API_TOKEN=
# Conceptual pin remains firtoz/trellis (models API 404s — code uses versioned predictions)
REPLICATE_MESH_MODEL=firtoz/trellis
# Optional version hash (or owner/name:hash). When empty, latest_version is resolved live.
REPLICATE_MESH_VERSION=
ROBOFLOW_API_KEY=
# Optional override host (default: detect for Universe, serverless for workspace/project/version)
# ROBOFLOW_INFER_HOST=
# Foot isolation (Universe: foot-segmentation)
ROBOFLOW_SEGMENT_MODEL=foot-segmentation-ehn9q/1
# Pathology (ulcers / lesions) — add secondary for ensemble
ROBOFLOW_MODEL=foot-ulcer/1
ROBOFLOW_MODEL_SECONDARY=wounds-detection/1
SCAN_QUALITY_THRESHOLD=70
SCAN_DEMO_IMAGE_URL=

# --- Shadow eval (Del Pilar Nexus custom endpoints) — default OFF in example ---
# Parallel inference for evaluation only. Does NOT replace Universe routing at canary 0%.
# See docs/vision/shadow-evaluation.md + privacy-gate.md + privacy-unlock-audit-2026-08-27.md
PRAXIS_SHADOW_EVAL_ENABLED=false
# Privacy-gate (all required before any custom Roboflow upload):
# PRAXIS_VISION_PRIVATE_PROJECT=true
# PRAXIS_VISION_EU_ROUTE_DOCUMENTED=true
# PRAXIS_VISION_DPA_SIGNED=true
# PRAXIS_VISION_DPA_STATUS=broser_operational_accept_2026-08-27
# PRAXIS_VISION_RESIDENCY_REVIEWED=true
# PRAXIS_VISION_RETENTION_POLICY_SET=true
# PRAXIS_VISION_HUMAN_APPROVER=Michael Ambrosius Broser
# PRAXIS_VISION_PRIVACY_AUDIT_EVENT_ID=broser-unlock-2026-08-27
# Optional model version suffix for workspace/endpoint/{version}
# ROBOFLOW_SHADOW_MODEL_VERSION=1

# Active routing governance (requires approved_for_active_routing in workflow JSON)
# Live custom models only when canary percent > 0 (hard-capped at 5 in code).
PRAXIS_ACTIVE_ROUTING_ENABLED=false
FOOT_VISION_CANARY_PERCENT=0

# CaptureGate-Σ — shadow blur/exposure/crop audit only (does NOT drive PASS/HOLD)
PRAXIS_CAPTURE_GATE_SHADOW=false

# TriView-Lift — InstantMesh A/B shadow (does NOT replace firtoz/trellis)
PRAXIS_TRIVIEW_SHADOW_ENABLED=false
# PRAXIS_TRIVIEW_INSTANTMESH_MODEL=   # must NOT be firtoz/trellis

# --- MitID OIDC broker -------------------------------------------------
# I prod: Idura / Signaturgruppen broker · client_id efter trust-aftale
MITID_BROKER_URL=https://broker.signaturgruppen.dk
MITID_CLIENT_ID=                    # tildelt af broker efter onboarding
MITID_CLIENT_SECRET=
MITID_REDIRECT_URI=http://127.0.0.1:3002/api/auth/mitid/callback

# --- DAWA --------------------------------------------------------------
# Public · ingen API-key krævet
DAWA_BASE_URL=https://api.dataforsyningen.dk

# --- CVR ---------------------------------------------------------------
# cvrapi.dk · gratis tier 1000 lookups/dag · vores proxy cacher 7 dage
CVR_API_URL=https://cvrapi.dk/api

# --- NemSMS ------------------------------------------------------------
# Via KOMBIT · sender-id godkendt af Erhvervsstyrelsen
# (roadmap: Bird.com afløser NemSMS til SMS/email/WhatsApp)
NEMSMS_BASE_URL=
NEMSMS_SENDER_ID=                   # f.eks. "PraxisOS"
NEMSMS_API_KEY=

# --- MedCom ------------------------------------------------------------
# VANS-routing · EAN-adresse tildelt af MedCom
MEDCOM_EAN=                         # 13-cifret EAN
MEDCOM_VANS=                        # vores VANS-provider
MEDCOM_API_KEY=

# --- Sundhedsdatastyrelsen / NSP ---------------------------------------
# Trust-aftale · FMK adgang
NSP_BASE_URL=https://test1.ekstern-test.nspop.dk
NSP_CLIENT_CERT=                    # PEM · server-side only
NSP_CLIENT_KEY=

# --- OpenAI / AI-pipelines ---------------------------------------------
# Til Niels (AI-scribe) · Aria (receptionist)
OPENAI_API_KEY=
WHISPER_MODEL=large-v3-da

# --- Sygesikringen "danmark" ------------------------------------------
# UN/EDIFACT D04A · webservice via VANS
DANMARK_PARTNER_ID=
DANMARK_API_KEY=

# --- Observability ----------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
LOGFLARE_API_KEY=

# =========================================================================
# Trial-kunder
# By Pilar (CVR 43947079) er markeret som trial-tenant i lib/tenants.ts:
#   trial: { unlimited: true, ... }
# Det giver alle moduler gratis · 0 platform-fee.
# Tilføj flere trial-tenants direkte i lib/tenants.ts (eller via Supabase).
# =========================================================================
