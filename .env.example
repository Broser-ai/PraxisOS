# =========================================================================
# PraxisOS · environment-eksempel
# kopiér til .env.local og udfyld før dev-start.
# Genereret fra grep -rho "process\.env\.[A-Z_]*" lib/ app/ — hver var her
# er faktisk læst af koden. Tomme værdier = sæt selv, ingen default i kode.
# =========================================================================

# --- Auth / Database ------------------------------------------------------
# "mock"            — alt fra in-memory mock i lib/*.ts (default)
# "supabase-local"  — lokal supabase via `supabase start`
# "supabase-eu"     — produktion · Frankfurt
PRAXIS_DB=mock

# Public Supabase project URL · bruges af lib/audit.ts til supabase-persist
NEXT_PUBLIC_SUPABASE_URL=

# Server-side only · aldrig i NEXT_PUBLIC_* · admin/audit-adgang
SUPABASE_SERVICE_ROLE_KEY=

# HMAC-secret til session-tokens (lib/session-token.ts) · påkrævet i prod
PRAXIS_SESSION_SECRET=

# Delt secret der autoriserer POST til /api/events (app/api/events/route.ts)
PRAXIS_EVENTS_SECRET=

# API-key vist/brugt på admin API-siden (app/(internal)/admin/api/page.tsx)
PRAXIS_API_KEY=

# --- MCP --------------------------------------------------------------
# Kommasepareret CORS-allowlist for /api/mcp/v1 (app/api/mcp/v1/route.ts)
PRAXIS_MCP_ORIGINS=

# Kommasepareret CORS-allowlist for booking-endpoint (app/api/v1/[tenant]/bookings/route.ts)
PRAXIS_BOOKING_ORIGINS=

# Roboflow MCP-server URL (lib/roboflow/mcp-client.ts) · default hvis tom
ROBOFLOW_MCP_URL=

# --- MDR-gate ------------------------------------------------------------
# Class IIa agent-dispatch persistens: "memory" | "supabase" | "stub"
PRAXIS_AUDIT_MODE=memory

# KUN til by Pilar-tenant · bypasser CE-mark-krav lokalt. MÅ ALDRIG
# være "1" i produktion (lib/dev-mode.ts throws hvis NODE_ENV=production)
PRAXIS_CLINICAL_DEV=

# Loader by Pilar seed-data i-memory til demo/tests (lib/dev-mode.ts)
PRAXIS_BYPILAR_SEED=

# --- Voice ------------------------------------------------------------
# "stub" kører uden rigtige voice-providers · alt andet kræver keys nedenfor
PRAXIS_VOICE_MODE=

# Deepgram ASR (lib/voice/asr-adapter.ts)
DEEPGRAM_API_KEY=

# "1" tillader ASR-stub selv uden DEEPGRAM_API_KEY (lib/voice/asr-adapter.ts)
PRAXIS_ASR_ALLOW_STUB=

# LiveKit realtime voice-session (lib/voice/livekit-adapter.ts)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# --- Vendors ------------------------------------------------------------
# Anthropic Claude · LLM-adapter + VLM-caller (lib/llm-adapter.ts, lib/scanner/vlm-caller.ts)
ANTHROPIC_API_KEY=

# Hugging Face Inference · fallback embeddings-provider (lib/embeddings/adapter.ts)
HF_INFERENCE_API_KEY=

# Voyage AI · primær embeddings-provider (lib/embeddings/adapter.ts)
VOYAGE_API_KEY=

# Replicate · GPU-lift adapter til scanner (lib/scanner/gpu-adapter.ts)
REPLICATE_API_TOKEN=
REPLICATE_LIFTER_VERSION=

# Roboflow · computer-vision API-key (lib/roboflow/mcp-client.ts)
ROBOFLOW_API_KEY=

# MedSAM segmenterings-service URL (lib/scanner/sprg-guardrails.ts)
MEDSAM_URL=

# Vorum/Mill CAD/CAM-adapter til ortoser (lib/orthotic/mill-adapter.ts)
MILL_API_KEY=
MILL_API_URL=

# Ekstern fod-scanner engine (lib/foot-scanner.ts)
FOOT_SCANNER_URL=
FOOT_SCANNER_TOKEN=

# Factoring-udbyder til Sygesikringen "danmark" fakturering
# (lib/finance/sygesikringen-factoring.ts)
FACTORING_API_KEY=
SYGESIKRINGEN_API_KEY=

# --- Feature-flags ------------------------------------------------------
# "true" aktiverer agent-orkestrering (lib/orchestrator.ts)
AGENT_ORCHESTRATION_ENABLED=

# "true" aktiverer scanner-upload-route v2 (app/api/v1/[tenant]/scans/upload/route.ts)
AGENT_SCANNER_V2_ENABLED=

# Sat = MediaPipe pose-extraction er tilgængelig (lib/gait/pose-extractor.ts)
MEDIAPIPE_ENABLED=

# "stub" kører LLM-kald uden rigtigt API-kald (lib/llm-adapter.ts)
PRAXIS_LLM_MODE=

# "stub" kører embeddings uden rigtigt API-kald (lib/embeddings/adapter.ts)
PRAXIS_EMBEDDINGS_MODE=

# "1" tillader embeddings-stub selv uden provider-key
PRAXIS_EMBEDDINGS_ALLOW_STUB=

# "stub" kører gait-analyse uden MediaPipe (lib/gait/pose-extractor.ts)
PRAXIS_GAIT_MODE=

# "1" tillader GPU-adapter-stub uden REPLICATE_API_TOKEN (lib/scanner/gpu-adapter.ts)
PRAXIS_GPU_ALLOW_STUB=

# "stub" kører mill-adapter uden rigtigt CAD/CAM-kald (lib/orthotic/mill-adapter.ts)
PRAXIS_MILL_MODE=

# "1" tillader SPRG-guardrails at mocke MedSAM (lib/scanner/sprg-guardrails.ts)
PRAXIS_SPRG_ALLOW_MOCK=

# "1" tillader VLM-caller-stub uden ANTHROPIC_API_KEY (lib/scanner/vlm-caller.ts)
PRAXIS_VLM_ALLOW_STUB=

# --- Runtime (sættes automatisk — udfyld IKKE manuelt) --------------------
# Sat af Next.js build/runtime
NODE_ENV=

# Sat af Vercel platform · bruges til fail-loud prod-check i lib/dev-mode.ts
VERCEL_ENV=

# Sat af Vercel platform · commit-sha vist i /api/health (app/api/health/route.ts)
VERCEL_GIT_COMMIT_SHA=

# Sat af Vitest test-runner · bruges til test-mock i lib/scanner/sprg-guardrails.ts
VITEST=

# =========================================================================
# Trial-kunder
# By Pilar (CVR 43947079) er markeret som trial-tenant i lib/tenants.ts:
#   trial: { unlimited: true, ... }
# Det giver alle moduler gratis · 0 platform-fee.
# Tilføj flere trial-tenants direkte i lib/tenants.ts (eller via Supabase).
# =========================================================================
