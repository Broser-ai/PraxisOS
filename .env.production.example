# PraxisOS · production env på Hetzner (kopiér til .env.production)
#
# ⚠️  PRODUCTION MUST NOT RUN ON PRAXIS_DB=mock.
#     Set PRAXIS_DB=supabase-eu (cloud) or self-host Postgres (docker-compose.db.yml)
#     and point SUPABASE_URL at the running API/PostgREST. See
#     docs/ops/p0-db-cutover-runbook.md + docs/ops/planway-praxisos-booking-cutover.md.
#     lib/supabase.ts assertProductionDbConfig() fails health loud on mock-in-prod
#     (NODE_ENV / PRAXIS_ENV / PRAXIS_REQUIRE_REAL_DB / public bypilar base URL).
PRAXIS_DB=supabase-eu
PRAXIS_ENV=production
PRAXIS_REQUIRE_REAL_DB=1
PRAXIS_HOST_PORT=3010
NEXT_PUBLIC_BASE_URL=https://app.bypilar.dk
PRAXIS_PUBLIC_BASE_URL=https://app.bypilar.dk
NEXT_PUBLIC_APP_REGION=eu-west-1

# --- Session + audit (REQUIRED in production) --------------------------
# HMAC session cookie signing — must be ≥16 chars. Currently ABSENT in older
# .env.production.example; lib/session-token.ts throws in prod without it.
PRAXIS_SESSION_SECRET=replace-with-32-char-random-secret
# Audit persistence: 'supabase' required before CE-mark (writes audit_log).
# 'memory' is dev/test only; 'stub' is for tests that opt out of audit.
PRAXIS_AUDIT_MODE=supabase

# --- Database (self-host Postgres via docker-compose.db.yml) ------------
# The app uses the Supabase JS client (SUPABASE_URL + service role), not a raw
# DATABASE_URL. Point SUPABASE_URL at your self-host Kong/PostgREST or the
# cloud EU project. POSTGRES_PASSWORD is only used by docker-compose.db.yml.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
POSTGRES_USER=praxis
POSTGRES_PASSWORD=
POSTGRES_DB=praxis
PRAXIS_PG_BIND=127.0.0.1
PRAXIS_PG_PORT=5432

# Bird.com SMS (workspace access key fra app.bird.com)
# Tip: nøgler kan også sættes via /admin/bird (gemmes i /data/secrets.json)
BIRD_API_KEY=
BIRD_AUTH_MODE=accesskey
BIRD_API_BASE=https://api.bird.com
BIRD_SMS_FROM=+4526325220
BIRD_SMS_CATEGORY=transactional
BIRD_WORKSPACE_ID=4ad3f57b-b826-4217-b068-77c9ac0f4f02
BIRD_SMS_CHANNEL_ID=

# --- AI agent automation ----------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_WORKER_SECRET=change-me-agent-worker
PRAXIS_EVENT_SECRET=change-me-event-bus
PRAXIS_DATA_DIR=/data
PRAXIS_DEFAULT_TENANT=bypilar
AGENT_TICK_MS=60000
AGENT_FORCE_FIRST_TICK=1

# --- S-H swarm · Meta harness · Prime RL (NO LoRA / NO auto-merge) ----
PRAXIS_SWARM_ENABLED=true
SWARM_APPROVE_TOKEN=change-me-swarm-approve
# PRIME_APPROVE_TOKEN=
SWARM_ALLOW_MAIN_MERGE=0
# SWARM_INTERVAL_MS=21600000

# --- Del Pilar Nexus · fod-scan (live quality PASS) --------------------
# Uden disse falder pipeline tilbage til demo/HOLD (fail-closed pathology)
REPLICATE_API_TOKEN=
REPLICATE_MESH_MODEL=firtoz/trellis
ROBOFLOW_API_KEY=
ROBOFLOW_SEGMENT_MODEL=foot-segmentation-ehn9q/1
ROBOFLOW_MODEL=foot-ulcer/1
ROBOFLOW_MODEL_SECONDARY=wounds-detection/1
