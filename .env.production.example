# PraxisOS · production env på Hetzner (kopiér til .env.production)
# Default forbliver mock indtil Kong/PostgREST + verify-rls er grøn.
# Cutover: PRAXIS_DB=supabase-selfhost — se docs/ops/supabase-to-hetzner-migration.md
PRAXIS_DB=mock
PRAXIS_HOST_PORT=3010
NEXT_PUBLIC_BASE_URL=https://app.bypilar.dk
PRAXIS_PUBLIC_BASE_URL=https://app.bypilar.dk
NEXT_PUBLIC_APP_REGION=eu-west-1

# Self-host DB (docker-compose.db.yml) — udfyld før `compose up` af DB
POSTGRES_USER=praxis
POSTGRES_PASSWORD=
POSTGRES_DB=praxisos
POSTGRES_HOST_PORT=5432
POSTGRES_HOST_BIND=127.0.0.1

# Når PRAXIS_DB=supabase-selfhost (Kong URL — ikke raw Postgres):
# SUPABASE_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_SUPABASE_URL=https://db.bypilar.dk
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# PRAXIS_AUDIT_MODE=supabase

# Bird.com SMS (workspace access key fra app.bird.com)
# Tip: nøgler kan også sættes via /admin/bird (gemmes i /data/secrets.json)
BIRD_API_KEY=
BIRD_AUTH_MODE=accesskey
BIRD_API_BASE=https://api.bird.com
BIRD_SMS_FROM=+4526325220
BIRD_SMS_CATEGORY=transactional
BIRD_WORKSPACE_ID=4ad3f57b-b826-4217-b068-77c9ac0f4f02
BIRD_SMS_CHANNEL_ID=

# --- AI agent automation ----------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_WORKER_SECRET=change-me-agent-worker
PRAXIS_EVENT_SECRET=change-me-event-bus
PRAXIS_DATA_DIR=/data
AGENT_TICK_MS=60000
AGENT_FORCE_FIRST_TICK=1

# --- Del Pilar Nexus · fod-scan (live quality PASS) --------------------
# Uden disse falder pipeline tilbage til demo/HOLD (fail-closed pathology)
REPLICATE_API_TOKEN=
REPLICATE_MESH_MODEL=firtoz/trellis
ROBOFLOW_API_KEY=
ROBOFLOW_SEGMENT_MODEL=foot-segmentation-ehn9q/1
ROBOFLOW_MODEL=foot-ulcer/1
ROBOFLOW_MODEL_SECONDARY=wounds-detection/1
